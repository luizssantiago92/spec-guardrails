# Project guardrails config (optional). Copy to .specs/config.yaml and edit.
# Or run: npx @luizsantiago/spec-guardrails init-config --preset node-ts
# Injected into phase procedures via phase-context.

schema: spec-driven

# Extend a built-in preset (default | node-ts | python | python-platform):
# extends: python-platform

context: |
  Tech stack: (fill in)
  Test command: npm test
  Branch prefix: feat

rules:
  specify:
    - Prefer EARS acceptance criteria
    - Mark unknowns with [NEEDS CLARIFICATION: question]
  tasks:
    - Every REQ must appear in the Test Coverage Matrix
  verify:
    - Evidence must cite test file:line paths

# Execution policy (optional — soft enforcement via CLI + skills)
budget:
  max_iterations: 5
  max_agent_runs: 12
  max_retries_per_task: 3

scope:
  allowed_paths: []
  denied_paths:
    - "**/.env"
    - "**/secrets/**"
    - "**/production/**"

escalation:
  on_scope_expansion: human
  on_budget_exhaustion: stop
  on_policy_violation: block

# Intent/effect rules (optional — pair with check-path --op read|write|delete)
effects:
  deny_delete:
    - "**/.git/**"
  deny_write: []
  deny_read: []
  warn_write: []
  warn_read: []
  warn_delete: []

# Memory retrieval (optional — hybrid FTS + graph + semantic)
memory:
  lifecycle:
    retention_days: 90
    auto_archive_on_handoff: false
  retrieval:
    semantic: false
    provider: none
    model: text-embedding-3-small
    max_chunks: 20
    fts_weight: 0.6
    semantic_weight: 0.4
    graph_depth: 1

# Elicitation (/elicit — optional, before Specify)
elicitation:
  max_questions_per_turn: 5
  kickoff_discovery_paths:
    - prd.md
    - docs/brief.md
    - docs/prd.md
    - .specs/project/kickoff.md
  # When true, validate-spec requires an approved requirements-brief.md
  require_brief: false
  # When true (default), Complex-tier features require a brief even if require_brief is false
  require_brief_complex: true
  # warn | error | off — NFR section on Complex-tier full specs
  require_nfr_complex: warn

# Soft OS sandbox (optional — policy, not containers; enforced via sandbox CLI)
sandbox:
  mode: warn
  deny_patterns:
    - "rm\\s+(-[^\\s]*f[^\\s]*\\s+-[^\\s]*r|-rf|-fr)\\s"
    - "curl\\b[^\\n|]*\\|\\s*(?:ba)?sh\\b"
    - "wget\\b[^\\n|]*\\|\\s*(?:ba)?sh\\b"
    - "git\\s+push\\b[^\\n]*(--force|--force-with-lease)[^\\n]*\\b(main|master)\\b"
    - "\\b(DROP\\s+DATABASE|DROP\\s+SCHEMA|TRUNCATE\\s+TABLE)\\b"

# Verification suppressions (optional — block agents from silencing linters/tests)
# Omit this block to keep runtime defaults from _project_config.py (9 patterns).
suppressions:
  patterns:
    - "#\\s*noqa\\b"
    - "nosemgrep\\b"
    - "eslint-disable(?:-next-line|-line)?"
    - "@ts-ignore\\b"
    - "@ts-expect-error\\b"
    - "\\bxit\\s*\\("
    - "\\bxdescribe\\s*\\("
    - "\\bpytest\\.mark\\.skip\\b"
    - "--no-verify\\b"

# Project quality commands (optional — run during /verify)
quality:
  checks:
    - npm test

# Ship / AI surface globs (optional — used by validate_ship_surface.py)
# ship_surface:
#   infra_globs:
#     - "**/Dockerfile"
#     - "**/docker-compose*.yml"
#     - "**/.github/workflows/**"
#   ai_globs:
#     - "**/prompts/**"
#     - "**/evals/**"
#     - "**/tests/eval/**"

# Commit policy (optional — used with check-commit --staged)
commit:
  max_staged_lines: 500

# Project-specific overrides (appended on top of preset + rules above):
# overrides:
#   rules:
#     verify:
#       - Also run playwright e2e before PASS
