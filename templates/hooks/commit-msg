#!/bin/sh
# Spec Guardrails — optional commit-msg hook (Brakes helpers)
#
# Install: npx @luizsantiago/spec-guardrails install-hooks
# Uninstall: npx @luizsantiago/spec-guardrails install-hooks --remove
#
# Git passes the proposed commit message file as $1. Read that path — do not
# open .git/COMMIT_EDITMSG from pre-commit, where it still holds the previous message.

set -e

if [ -z "$1" ]; then
  echo "[spec-guardrails] commit-msg hook requires the message file path (\$1)"
  exit 1
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ ! -d ".specs/guardrails/scripts" ]; then
  echo "[spec-guardrails] .specs/guardrails/scripts missing — run: npx @luizsantiago/spec-guardrails install"
  exit 1
fi

PYTHON=""
for candidate in python3 python "py -3"; do
  if command -v ${candidate%% *} >/dev/null 2>&1; then
    if $candidate --version 2>&1 | grep -qE 'Python 3\.(1[0-9]|[2-9][0-9])'; then
      PYTHON="$candidate"
      break
    fi
  fi
done

if [ -z "$PYTHON" ]; then
  echo "[spec-guardrails] Python 3.10+ not found — skipping Brakes commit-msg checks (Process mode)."
  exit 0
fi

echo "[spec-guardrails] check-commit"
$PYTHON .specs/guardrails/scripts/check_commit.py --file "$1"

exit 0
